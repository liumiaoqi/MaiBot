#!/bin/sh
# 提交门（2026-09-24 立 ｜ 2026-09-25 加决策索引 ②③④ ｜ 2026-09-26 泛化成"有索引才生效"）
#
# ⭐ 这一份文件在多个仓里**字节一致**（`sha256` 相同 ⇒ 行为一致，一处改动一处核实）。
#    **没有索引文件的仓**：门②③④ 自动跳过（不是死代码，而是"将来长出索引即生效"）。
#    校验方式：`sha256sum .githooks/pre-commit` 各仓相同；行为判据见下。
#
# 设计原则（照 dsh 的做法，但去掉 lefthook 依赖）：
#   ① 零依赖：纯 POSIX sh，不 require node_modules / 不 require 外部二进制
#   ② 快：只查「本次暂存的内容」，不扫全仓
#   ③ 精准：只拦「你这次引入的问题」，不为历史存量天天报警
#      —— ⚠️ 一条永远响的警报会被无视（复盘 0035 的教训）
#   ④ 可绕过：`git commit --no-verify`（知道自己在做什么时用）
#
# 规范真源：CONVENTIONS.md §10（行尾）· §10.5（空白/行尾相关的坑）
#           + 索引纪律：各索引文件自己的头部 + 台账 I-104
# 机制来源：dsh 的 lefthook.yml 里那条 `whitespace (staged): git diff --cached --check`
#
# ⚠️⚠️ 已修 bug ①（2026-09-24，勿退化）：原来写的是
#        if ! git diff --cached --check --quiet; then …
#     而 `--quiet` 的语义是「有差异就返回 1」—— 它压过了 `--check` 的语义，
#     导致【只要有任何 staged 改动，门就报错】。
#     ⇒ 教训：**"能拦住坏的"不证明"不误拦好的"—— 必须测对照组**（复盘 0029）。
#     ⇒ 现在的判据：`git diff --cached --check` 的【输出非空】或【退出码非 0】即有问题。
#
# ── 门②③④ 的来历（2026-09-26，台账 I-104）
#     现场：dsh 17:45 提交的索引行，20:06 被「旧副本整份写回」抹掉（磁盘版逐字节等于父提交）。
#     ⇒ 三条检查的判据（都只看【本次暂存】）：
#       门②  本次【新增】的索引目录内正文，必须在对应索引里出现（漏登记）
#       门③  暂存版索引里【仓内相对】的链接目标必须存在（跳 :// 与盘符/绝对路径）
#       门④  索引条目【净减少】却没删任何正文 ⇒ 很可能在用旧副本覆盖索引
#     ⚠️ 门③ 必须跳过外部链接 —— 实测：`decisions/INDEX.md` 有 9 条、`postmortems/INDEX.md` 有 35 条
#        全是 `file:///` 跨仓链接；不跳就是几十条永久误报（正是原则③ 要避免的）。
#
# ⚠️⚠️ 已修 bug ②（2026-09-26，门③ 初版）：抽链接用的是 `sed -n 's/.*](\([^)]*\)).*/\1/p'`，
#     它在【真实索引】上会抽出**表格单元格内容**（"参考" · "|" · "`accepted`（已迁 "），
#     一次跑出 **23 条误报** —— 因为行内存在没有 ASCII `)` 收尾的 `](` 片段，捕获一路吃到后面的单元格。
#     ⇒ 修法：**只接受形状干净的目标**（`*.md` 且只含 `[A-Za-z0-9._/-]`），其余一律跳过；顺带 `tr -d '\r'`。
#     ⇒ 教训：**门的判据必须在【真实数据】上量过**；抓到它的是对照组「合法编辑也必须放行」（复盘 0029 再证）。
#
# ⚠️⚠️ 已修 bug ③（2026-09-26，门④ 初版）：用「diff 里有 `-| ` 行」判"删了条目" ——
#     但**修改一行的 diff 同样是「删+增」** ⇒ 只改摘要文字也被判"删了 1 行"（对照组再次抓到）。
#     ⇒ 修法：比 **`^| \[` 行的净数**（`HEAD` 版 vs 暂存版），只有**净减少**才算。
#     ⇒ 教训：**别用"diff 里有删除行"当"内容被删"的判据**；判"净减"而不是"有减"。
#
# ⚠️⚠️ 已修 bug ④（2026-09-26，门③ 抽链接取"最后一个"）：`.*](…` 是**贪婪**的 ⇒ 会捡到**摘要里的内联链接**
#     （实测 `postmortems/INDEX.md` L49 摘要写 `[0029](0029-no-control-group-in-verification_0915.md)` ⇒
#      被当成仓内路径去查、而该文件在中枢根本不存在 ⇒ 误报，且**每次编辑复盘总账都会拦**＝存量的永久警报）。
#     ⇒ 修法：改成**从行首取每行【第一个】链接**（`^[^]]*](…`）—— 行首那个才是该条目的身份。
#     ⇒ 教训：**判据要问"哪个才是这条记录的身份"** —— 一行里有多个链接时，"最后一个"不是默认答案。

fail=0

# ⚠️⚠️ 2026-09-30 加【门⓪ 自动修】—— lmq 要求："有些小细节被拦了，直接由门改掉就好，节省 token"
#   动机：一天里因为「末尾多一个空行」被拦两次、因「CRLF」被拦一次 ⇒ 每次都是一个来回。
#   只修**机械可逆、无语义变化**的三类：
#     · CRLF / 单独 CR → LF（各仓 `.gitattributes` 声明 `* text=auto eol=lf`）
#     · 行尾空格 —— ⚠️ **跳过 `*.md`**：Markdown 里两个行尾空格是**硬换行**，那是语义不是噪声
#     · 末尾多余空行 → 压成恰好一个换行（就是拦了我两次的那条）
#   三条安全约束（都落在代码里，不靠自觉）：
#     ① 只修【暂存内容 == 工作区内容】的文件 —— 否则会把**未暂存的改动**一起提交（用 `git diff --quiet` 判）
#     ② 只修**文本**文件（按扩展名跳过二进制 —— 二进制上 `tr -d '\r'` 会毁数据）
#     ③ 修完**重新 `git add`**；随后 ① **再查一遍**，① 仍报错 ⇒ **仍拦**（自动修不是放行的理由）
autofixed=""
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
    case "$f" in
        *.pdf|*.png|*.jpg|*.jpeg|*.gif|*.zip|*.gz|*.bin|*.apk|*.jar|*.exe|*.so|*.dll|\
        *.xlsx|*.xls|*.docx|*.doc|*.pptx|*.ppt|*.ico|*.ttf|*.woff|*.woff2|*.pdf) continue ;;
    esac
    [ -f "$f" ] || continue
    # ① 暂存内容必须与工作区一致（否则自动修会把未暂存的改动一并提交）
    git diff --quiet -- "$f" || continue

    before=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
    did=""

    # CRLF / CR → LF
    # ⚠️⚠️ 检测必须用 `od` 按**字节**看 —— 实测：git-bash 的 `grep` 在 Windows 上以**文本模式**读文件，
    #     CR 对它**不可见**（`grep -q "$(printf '\r')"` 恒不命中）⇒ 这一支曾静默失效。
    #     （与「PowerShell 文本管道会重插 CR」同族：**别用文本工具判字节**。）
    if od -An -c "$f" 2>/dev/null | grep -q '\\r'; then
        tr -d '\r' < "$f" > "$f.docgen-fix" && mv "$f.docgen-fix" "$f" && did="$did CRLF→LF"
    fi

    # 行尾空格（跳过 .md：那是 Markdown 的硬换行）
    case "$f" in
        *.md) ;;
        *) if grep -q '[[:space:]]$' "$f" 2>/dev/null; then
               sed 's/[[:space:]]*$//' "$f" > "$f.docgen-fix" && mv "$f.docgen-fix" "$f" && did="$did 行尾空格"
           fi ;;
    esac

    # 末尾多余空行 → 恰好一个换行
    if [ -n "$(tail -c 2 "$f" 2>/dev/null | grep -c '^$')" ] && [ "$(tail -c 2 "$f" 2>/dev/null | od -An -c | tr -d ' ')" = "\n\n" ]; then
        awk '{n[NR]=$0} END{while(NR>0 && n[NR]=="")NR--; for(i=1;i<=NR;i++) print n[i]}' "$f" > "$f.docgen-fix" \
            && mv "$f.docgen-fix" "$f" && did="$did 末尾空行"
    fi

    if [ -n "$did" ]; then
        after=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
        git add -- "$f"
        autofixed="$autofixed
    $f:$did（$before→$after 字节，已重新 add）"
    fi
done

if [ -n "$autofixed" ]; then
    echo "  [提交门·⓪ 自动修] 以下小问题已由门改掉并重新暂存（无需你手动修）：$autofixed" >&2
    echo "     ⚠️ 只改了机械项：CRLF→LF / 行尾空格（.md 除外）/ 末尾多余空行。内容一个字没动。" >&2
fi

# ── 门 ①：暂存内容的空白/行尾（dsh 同款）
# 覆盖：行尾空格、多余空行、CRLF 混入（git 的 whitespace 规则集）
# ⚠️ 先跑门⓪ 自动修；这里查的是**自动修没覆盖到**的问题 ⇒ 仍拦
# ⚠️⚠️ 2026-09-30：`*.md` 的行尾空格**放行** —— 与门⓪「跳过 .md」**保持一致**。
#     理由：Markdown 里两个行尾空格是**硬换行语法**（语义，不是噪声）。
#     实测：加了门⓪ 之后，b.md 的两处硬换行仍被 ① 拦下 ⇒ 两边自相矛盾（对照组测出来的）。
check_raw=$(git diff --cached --check 2>&1)
check_rc=$?
md_hits=$(printf '%s\n' "$check_raw" | grep -c '\.md:[0-9]*: ')
# ⚠️ 过滤必须**带状态**：`git diff --cached --check` 的输出除了 `文件:行: 原因` 还有**紧跟着的内容行**
#   （形如 `+# 标题  `）⇒ 只滤报告行会把内容行漏下来、照样判"有问题"（第一次就是这么错的，对照组测出来）。
check_out=$(printf '%s\n' "$check_raw" | awk '
    /\.md:[0-9]+: / { skip = 1; next }     # .md 的报告行：连同它后面紧跟的 + 内容行一起跳过
    skip && /^\+/   { next }
    { skip = 0 }
    /^$/            { next }
    { print }
')

if [ -n "$check_out" ] || { [ -z "$check_raw" ] && [ "$check_rc" -ne 0 ]; }; then
    echo "" >&2
    echo "  [提交门·① 空白/行尾] ✗ 暂存内容存在空白/行尾问题：" >&2
    [ -n "$check_out" ] && printf '%s\n' "$check_out" | head -20 >&2
    [ -z "$check_out" ] && echo "    （git 未给出明细，退出码 $check_rc）" >&2
    echo "" >&2
    echo "  规范：CONVENTIONS.md §10（行尾一律 LF；无行尾空格）" >&2
    echo "  处理：修好后重新 git add；确认无误可 git commit --no-verify 绕过" >&2
    echo "" >&2
    fail=1
fi

if [ "${md_hits:-0}" -gt 0 ] && [ -z "$check_out" ]; then
    echo "  [提交门·①] 放行 $md_hits 处 *.md 行尾空格（Markdown 硬换行语法；门⓪ 也刻意不修它）" >&2
fi

# ── 门 ⑤：作者身份（2026-09-29 加）
#    顺序说明：① 与 ⑤ 每次都跑（它们查的是"提交本身"），②③④ 只在暂存动到某个索引所在目录时跑。
#    编号是加入顺序，不是执行顺序。
#
#    起因：hub 与 notification-keep 两个仓里共 137 条提交的作者邮箱是编的
#          （`liumiaoqi@local` / `@localhost`），而**全局配置里本来就有正确的那个**：
#          `68047429+liumiaoqi@users.noreply.github.com`。
#          那些错的几条，全部来自提交命令上的 `-c user.email=…` —— 它覆盖了全局配置。
#
#    为什么要拦：那个错**是静默的**。提交成功、退出码 0、git log 里名字也对，
#                只有到 GitHub 上才看得出来（关联不到账号：灰头像、不计贡献）。
#
#    判据：作者/提交者邮箱不该是本地编的域名。
#
#    ⚠️ 2026-09-29 撤销一次错误的豁免：我曾把这一门改成"只对有远程的仓生效"，
#       理由是"无远程 ⇒ 不会推 ⇒ 不需要关联账号"。**那个推理是错的** ——
#       邮箱是提交里的**身份声明**，它对不对与这个仓推不推无关；
#       有远程只是让这个错**显形**（GitHub 上灰头像），无远程只是让它**没症状**。
#       而"无远程所以随便写"等于给错误开豁免，且哪天加了远程，那批假身份**已经进了历史**。
#       （触发这个撤销的是 lmq 的一问：「托不托管和邮箱有什么关系」）
#
#       同时纠正另一句我之前说的话：我曾说 `~/.dsh` 那个仓用 `@local` 是"刻意的、合理的"
#       （理由是该仓含 .credentials.yaml）。核过之后那句不成立 ——
#       那个仓的 .gitignore 本来就挡住了凭据，tracked 118 个文件里一个凭据都没有；
#       而且那个仓自己的提交从 09-28 起就改用真邮箱了，`@local` 只是它建仓第一天的痕迹、
#       以及我后来又一次带进去的。
#
#       "不想暴露真实邮箱"这个需求本来就有解：`68047429+liumiaoqi@users.noreply.github.com`
#       不含真实邮箱、且能关联账号。⇒ **没有任何场景需要用 `@local`**。
#
#    处理：`git config --global user.email` 看正确的那个；提交时**不要带** `-c user.email`。
author_ident=$(git var GIT_AUTHOR_IDENT 2>/dev/null)
committer_ident=$(git var GIT_COMMITTER_IDENT 2>/dev/null)
author_email=$(printf '%s\n' "$author_ident" | sed -n 's/.*<\(.*\)>.*/\1/p')
committer_email=$(printf '%s\n' "$committer_ident" | sed -n 's/.*<\(.*\)>.*/\1/p')

for who_email in "作者:$author_email" "提交者:$committer_email"; do
    who=${who_email%%:*}
    em=${who_email#*:}
    case "$em" in
        *@local|*@localhost|"")
            echo "" >&2
            echo "  [提交门·⑤ 身份] ✗ ${who}邮箱是 $em —— 它关联不到 GitHub 账号" >&2
            echo "    （全局配置里本来就有正确的：git config --global user.email）" >&2
            echo "" >&2
            echo "  原因：提交命令带了 -c user.email=… ⇒ 去掉那个 -c 即可" >&2
            echo "  处理：确认无误可 git commit --no-verify 绕过" >&2
            echo "" >&2
            fail=1
            ;;
    esac
done

# ── 门②③④：索引一致性（对每个存在的索引跑；没索引的仓自动跳过）
#    ⭐ 加一个新索引 = 往下面这行列表里加一个路径（正文目录 = 索引所在目录）
staged=$(git diff --cached --name-only)

for idxpath in decisions/INDEX.md postmortems/INDEX.md; do
    dir=$(dirname "$idxpath")

    # 只在本次暂存动到【该索引所在目录】时才跑这个索引
    printf '%s\n' "$staged" | grep -q "^$dir/" || continue

    idx=$(git show ":$idxpath" 2>/dev/null)
    idx_old=$(git show "HEAD:$idxpath" 2>/dev/null)

    # 门②：本次【新增】的目录内正文必须在该索引里登记
    for f in $(git diff --cached --name-only --diff-filter=A -- "$dir/*.md" | grep -v "^$idxpath\$"); do
        b=$(basename "$f")
        if ! printf '%s\n' "$idx" | grep -qF "$b"; then
            echo "  [提交门·② 索引登记] ✗ 新增的正文未在 $idxpath 里登记：$f" >&2
            echo "     处理：在索引里加一行（含摘要/类型/生命周期/位置），或确认该文件不该进 $dir/" >&2
            fail=1
        fi
    done

    if printf '%s\n' "$staged" | grep -q "^$idxpath\$"; then

        # 门③：索引里【仓内相对】的链接目标必须存在（跳过 URL / 绝对路径 / 盘符路径）
        #   ⚠️ 取【每行第一个】链接（行首那个才是该条目的身份）；贪婪取最后一个会捡到摘要里的内联链接
        #      —— 实测：`postmortems/INDEX.md` L49 的摘要里有 `[0029](0029-….md)` 这种仓内短写，
        #      贪婪版把它当路径去查 ⇒ 误报（见文件头「已修 bug ④」）。
        #   ⚠️ 形状校验见文件头「已修 bug ②」
        for t in $(printf '%s\n' "$idx" | sed -n 's/^[^]]*](\([^)]*\)).*/\1/p' | tr -d '\r' | sort -u); do
            case "$t" in
                *://*|/*|[A-Za-z]:*) continue ;;
            esac
            case "$t" in
                *.md) ;;
                *) continue ;;
            esac
            case "$t" in
                *[!A-Za-z0-9._/-]*) continue ;;
            esac
            if [ ! -f "$dir/$t" ] && [ ! -f "$t" ]; then
                echo "  [提交门·③ 索引指向] ✗ $idxpath 里写的仓内文件不存在：$t" >&2
                fail=1
            fi
        done

        # 门④：索引条目【净减少】却没删任何正文 ⇒ 疑似旧副本覆盖（台账 I-104）
        #   ⚠️ 不能用「diff 里有 -| 行」判：修改一行在 diff 里同样是「删+增」⇒ 会误报（bug ③）
        rows_before=$(printf '%s\n' "$idx_old" | grep -c '^| \[')
        rows_after=$(printf '%s\n' "$idx" | grep -c '^| \[')
        del_files=$(git diff --cached --name-only --diff-filter=D -- "$dir/*.md" | grep -vc "^$idxpath\$")
        if [ -n "$idx" ] && [ "$rows_after" -lt "$rows_before" ] && [ "$del_files" -eq 0 ]; then
            echo "  [提交门·④ 索引条目净减少] ✗ $idxpath 表行数 $rows_before → $rows_after，但没删除任何正文：" >&2
            git diff --cached -U0 -- "$idxpath" | grep '^-| ' | head -3 | cut -c1-120 >&2
            echo "     ⚠️ 常见原因：拿【旧副本】整份覆盖了索引（台账 I-104：会静默丢行）" >&2
            echo "     ⚠️ 合法改法：确实要精简 ⇒ 连同正文一起处理，或 git commit --no-verify" >&2
            fail=1
        fi

    fi
done

# ── 预留段（未上线）：本次暂存是否引入「库内 CRLF」
# 暂不上线的理由：存量未收口的文件会造成误报（见复盘 0035「永远响的警报」）。
#   bad=$(git diff --cached --name-only -z | tr '\0' '\n' | while read -r f; do
#           [ -f "$f" ] || continue
#           case "$f" in *.pdf|*.png|*.jpg|*.zip|*.bin|*.gz) continue;; esac
#           if head -c 200000 "$f" 2>/dev/null | grep -q "$(printf '\r')"; then echo "$f"; fi
#         done)
#   [ -n "$bad" ] && { echo "[提交门] ✗ 含 CRLF：$bad" >&2; fail=1; }

exit $fail
