(* probe5_tn_compression.wls -- exp37 tensor-network compression:
   spectrum structure (signal rank vs MP noise band), Eckart-Young predictions,
   and exact replay of the retrieval table on fixed data (cross-platform).
   Ref: trading/exp37_tensor_network_compression.py
   Requires: data_exp37/*.csv generated by make_data_exp37.py
   Run: wolframscript -file probe5_tn_compression.wls *)

Off[General::munfl];
fmt[x_, d_] := ToString[NumberForm[N[x], {16, d}]];
base = DirectoryName[$InputFileName];

loadCSV[p_] := Module[{raw = Import[p, "Table", "FieldSeparators" -> ","]},
  If[NumericQ[raw[[1, 1]]], raw, Map[ToExpression, raw, {2}]]];

X = loadCSV[FileNameJoin[{base, "data_exp37", "X.csv"}]];
Q = loadCSV[FileNameJoin[{base, "data_exp37", "queries.csv"}]];
L = Flatten[loadCSV[FileNameJoin[{base, "data_exp37", "labels.csv"}]]];
Cen = loadCSV[FileNameJoin[{base, "data_exp37", "centers.csv"}]];

Print["=== probe5: exp37 tensor-network compression (Wolfram ", $Version, ") ==="];

sv = SingularValueList[X];
Print["--- spectrum (top 16) ---"];
Print[Row[Map[fmt[#, 3] &, sv[[1 ;; 16]]], "  "]];
Print["sigma8/sigma9 = ", fmt[sv[[8]]/sv[[9]], 3],
      "    MP noise edge ~ sigma(sqrt(T)+sqrt(D)) = ", fmt[0.3*(Sqrt[200] + Sqrt[64]), 3]];
Print["centers singular values (8): ", Row[Map[fmt[#, 3] &, SingularValueList[Cen]], "  "],
      "   (=5x blocks -> signal band ~ 5 x these)"];

Print["--- Eckart-Young predicted reconstruction error ---"];
ecy[r_] := Sqrt[Total[sv[[r + 1 ;;]]^2]/Total[sv^2]];
Do[Print["r=", r, " : ", fmt[ecy[r], 3]], {r, {3, 6, 15, 30}}];

(* --- exact replay of the retrieval table on the fixed data --- *)
topicOf0[i0_] := Min[7, Floor[i0*8/200]];
bucketOf[lab_] := Which[lab >= 5, 1, lab >= 2, 2, True, 3];

runConfig[cand_, offset_, projFn_] := Module[{acc = {0, 0, 0}, cnt = {0, 0, 0}, ok, bt, b, sc, lab, qv},
  Do[
    lab = L[[qi]]; qv = Q[[qi]];
    sc = cand . projFn[qv];
    b = First[Ordering[sc, -1]];
    ok = topicOf0[b - 1 + offset] == lab;
    bt = bucketOf[lab];
    If[ok, acc[[bt]] = acc[[bt]] + 1];
    cnt[[bt]] = cnt[[bt]] + 1,
    {qi, Length[L]}];
  MapThread[If[#2 == 0, 0., #1/#2] &, {acc, cnt}]];

{U, W, V} = SingularValueDecomposition[X];
Vh = ConjugateTranspose[V];
tnCand[r_] := U[[All, 1 ;; r]] . W[[1 ;; r, 1 ;; r]];
tnProj[r_] := Function[q, Vh[[1 ;; r]] . q];

Print["--- retrieval replay (fixed data) ---"];
Print[StringPadRight["config", 22], "  new   mid   old"];
res = {{"full", runConfig[X, 0, Identity]},
       {"trunc K=100", runConfig[X[[-100 ;;]], 100, Identity]},
       {"tn r=15", runConfig[tnCand[15], 0, tnProj[15]]},
       {"trunc K=40", runConfig[X[[-40 ;;]], 160, Identity]},
       {"tn r=6", runConfig[tnCand[6], 0, tnProj[6]]}};
Do[
  Print[StringPadRight[res[[i, 1]], 22], "  ",
        Row[Map[ToString[Round[#*100]] &, res[[i, 2]]], "   "]],
  {i, Length[res]}];
