{
    "manifest_version": 3,
    "id": "maibot-team.hello-world-plugin",
    "version": "3.0.0",
    "name": "Hello World 示例插件",
    "description": "SDK v4 示例插件，包含问候功能、时间查询等基础示例",
    "author": {
        "name": "MaiBot开发团队",
        "url": "https://github.com/MaiM-with-u"
    },
    "license": "GPL-3.0-or-later",
    "urls": {
        "repository": "https://github.com/MaiM-with-u/maibot",
        "homepage": "https://github.com/MaiM-with-u/maibot"
    },
    "changelog": "CHANGELOG.md",
    "host_application": {
        "min_version": "1.0.0"
    },
    "sdk": {
        "min_version": "4.0.0"
    },
    "scopes": [
        "message:send:text",
        "message:send:forward",
        "message:send:hybrid",
        "database:read:self",
        "database:write:self"
    ]
}
